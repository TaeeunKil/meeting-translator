<Window x:Class="MeetingTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meeting Translator"
        Width="1280"
        Height="840"
        MinWidth="880"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#FAF9F6"
        Foreground="#111111"
        FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#FAF9F6"/>
    <SolidColorBrush x:Key="PaperBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SoftBrush" Color="#F2EFEA"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#DEDAD4"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#7B7B78"/>
    <SolidColorBrush x:Key="InkBrush" Color="#111111"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF5600"/>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#7B7B78"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#111111"/>
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="QuietButton" TargetType="Button">
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#111111"/>
      <Setter Property="BorderBrush" Value="#111111"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.62"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ProviderButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
      <Setter Property="Padding" Value="7,9"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#626260"/>
      <Setter Property="BorderBrush" Value="#DEDAD4"/>
      <Setter Property="FontSize" Value="10"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
      <Setter Property="MinWidth" Value="126"/>
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#313130"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <DataTemplate x:Key="TranscriptLineTemplate">
      <Grid Margin="0,0,0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,24,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding OriginalText}"
                     TextWrapping="Wrap"
                     FontSize="15"
                     LineHeight="23"/>
          <TextBlock Grid.Column="1"
                     Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                     Margin="16,3,0,0"
                     Foreground="#A09D98"
                     FontSize="9"/>
        </Grid>

        <Border Grid.Column="1"
                Margin="0,-4,0,-4"
                Background="#E7E3DD"/>

        <StackPanel Grid.Column="2" Margin="24,0,0,0">
          <TextBlock Text="{Binding TranslatedText}"
                     TextWrapping="Wrap"
                     Foreground="#393936"
                     FontSize="14"
                     LineHeight="22"/>
          <TextBlock Text="{Binding ProviderLabel}"
                     Margin="0,5,0,0"
                     Foreground="#A09D98"
                     FontSize="9"/>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SpeakerGroupTemplate">
      <Border Margin="32,0"
              Padding="0,20,0,18"
              BorderBrush="#E7E3DD"
              BorderThickness="0,0,0,1"
              Opacity="0">
        <Border.RenderTransform>
          <TranslateTransform Y="6"/>
        </Border.RenderTransform>
        <Border.Triggers>
          <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 To="1" Duration="0:0:0.16"/>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                 To="0" Duration="0:0:0.16"/>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Border.Triggers>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Margin="0,1,20,0">
            <Border Width="28" Height="28"
                    HorizontalAlignment="Left"
                    Background="#111111"
                    CornerRadius="14">
              <TextBlock Text="{Binding SourceInitial}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="#FFFFFF"
                         FontSize="10"
                         FontWeight="Bold"/>
            </Border>
            <TextBlock Text="{Binding SpeakerName}"
                       Margin="0,8,0,0"
                       FontSize="11"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StartedAt, StringFormat=HH:mm:ss}"
                       Margin="0,4,0,0"
                       Foreground="#9C9A96"
                       FontSize="9"/>
          </StackPanel>

          <ItemsControl Grid.Column="1"
                        ItemsSource="{Binding Lines}"
                        ItemTemplate="{StaticResource TranscriptLineTemplate}">
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Margin" Value="0,0,0,16"/>
              </Style>
            </ItemsControl.ItemContainerStyle>
          </ItemsControl>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="LayoutRoot" Opacity="0">
    <Grid.RenderTransform>
      <TranslateTransform Y="10"/>
    </Grid.RenderTransform>
    <Grid.Triggers>
      <EventTrigger RoutedEvent="Loaded">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.22"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             To="0" Duration="0:0:0.22"/>
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Grid.Triggers>

    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SettingsColumn" Width="324"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border x:Name="SettingsSidebar"
            Grid.Column="0"
            Background="{StaticResource CanvasBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid Margin="24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="0"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="34" Height="34" CornerRadius="4"
                    Background="{StaticResource InkBrush}">
              <TextBlock Text="M"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="#FFFFFF"
                         FontSize="17"
                         FontWeight="Bold"/>
            </Border>
            <StackPanel Margin="11,-1,0,0">
              <TextBlock Text="Meeting"
                         FontSize="18"
                         FontWeight="SemiBold"/>
              <TextBlock Text="Translator"
                         Margin="0,-2,0,0"
                         Foreground="#7B7B78"
                         FontSize="12"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Text="선택한 캡션을 읽어 원하는 엔진으로 번역합니다."
                     Margin="0,16,0,0"
                     Foreground="#7B7B78"
                     FontSize="11"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,28,0,18"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,0">
          <TextBlock Text="캡션 소스" FontSize="14" FontWeight="SemiBold"/>
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="WindowsCaptionButton"
                    Content="Windows 자막"
                    Click="WindowsCaption_Click"
                    Style="{StaticResource ProviderButton}"
                    Margin="0,0,4,0"/>
            <Button x:Name="TeamsCaptionButton"
                    Grid.Column="1"
                    Content="Teams 자막"
                    Click="TeamsCaption_Click"
                    Style="{StaticResource ProviderButton}"
                    Margin="4,0,0,0"/>
          </Grid>
          <TextBlock x:Name="CaptionSourceHintText"
                     Text="모든 앱 · 로컬 음성 인식 · 화자 구분 없음"
                     Margin="2,8,0,0"
                     Foreground="#7B7B78"
                     FontSize="10"/>

          <Border Margin="0,20,0,18"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,1,0,0"/>

          <TextBlock Text="번역 엔진" FontSize="14" FontWeight="SemiBold"/>
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="FreeGoogleButton"
                    Content="무료 Google"
                    Click="FreeGoogle_Click"
                    Style="{StaticResource ProviderButton}"
                    Margin="0,0,4,0"/>
            <Button x:Name="GoogleCloudButton"
                    Grid.Column="1"
                    Content="Google Cloud"
                    Click="GoogleCloud_Click"
                    Style="{StaticResource ProviderButton}"
                    Margin="2,0"/>
            <Button x:Name="QwenButton"
                    Grid.Column="2"
                    Content="사내 Qwen"
                    Click="Qwen_Click"
                    Style="{StaticResource ProviderButton}"
                    Margin="4,0,0,0"/>
          </Grid>

          <Border Margin="0,12,0,0"
                  Padding="14"
                  Background="#F2EFEA"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <Grid>
              <StackPanel x:Name="FreeGooglePanel">
                <TextBlock Text="무료 Google"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                <TextBlock Text="API 키 없이 바로 사용합니다. 개인용·실험용으로 적합하며 제공 방식이 바뀌면 중단될 수 있습니다."
                           Margin="0,7,0,0"
                           Foreground="#7B7B78"
                           FontSize="10"
                           TextWrapping="Wrap"
                           LineHeight="15"/>
              </StackPanel>

              <StackPanel x:Name="GoogleCloudPanel" Visibility="Collapsed">
                <TextBlock Text="Google Cloud Translation"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                <Grid Margin="0,11,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="이번 달 앱 사용량"
                             Style="{StaticResource SectionLabel}"/>
                  <TextBlock x:Name="CloudUsageText"
                             Grid.Column="1"
                             Text="0 / 490,000자"
                             Foreground="#626260"
                             FontSize="10"
                             FontWeight="SemiBold"/>
                </Grid>
                <ProgressBar x:Name="CloudUsageBar"
                             Height="5"
                             Margin="0,7,0,0"
                             Minimum="0"
                             Maximum="490000"
                             Foreground="{StaticResource AccentBrush}"
                             Background="#DEDAD4"
                             BorderThickness="0"/>
                <TextBlock Text="490,000자에서 API 호출을 차단합니다. 다른 앱의 사용량은 포함되지 않습니다."
                           Margin="0,7,0,0"
                           Foreground="#7B7B78"
                           FontSize="9"
                           TextWrapping="Wrap"
                           LineHeight="13"/>
                <TextBlock Text="프로젝트 ID"
                           Margin="0,12,0,0"
                           Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="ProjectIdBox" Margin="0,6,0,0"/>
                <TextBlock Text="서비스 계정 JSON"
                           Margin="0,12,0,0"
                           Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="CredentialsBox" Margin="0,6,0,0"/>
                <Button x:Name="BrowseButton"
                        Content="JSON 파일 선택"
                        Click="BrowseCredentials_Click"
                        Style="{StaticResource QuietButton}"
                        Margin="0,7,0,0"/>
              </StackPanel>

              <StackPanel x:Name="QwenPanel" Visibility="Collapsed">
                <TextBlock Text="사내 Qwen · OpenAI 호환"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                <TextBlock Text="서버 주소"
                           Margin="0,13,0,0"
                           Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="QwenBaseUrlBox" Margin="0,6,0,0"/>
                <TextBlock Text="모델"
                           Margin="0,12,0,0"
                           Style="{StaticResource SectionLabel}"/>
                <TextBox x:Name="QwenModelBox" Margin="0,6,0,0"/>
                <CheckBox x:Name="QwenFallbackCheck"
                          Content="연결 실패 시 무료 Google로 대체"
                          Margin="0,11,0,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock x:Name="ProviderHintText"
                     Text="기본 엔진 · 별도 설정 없음"
                     Margin="2,9,0,0"
                     Foreground="#7B7B78"
                     FontSize="10"/>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3">
          <Border Padding="14"
                  Background="#FFFFFF"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8"
                         Fill="#FF5600"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"/>
                <TextBlock x:Name="CaptionSourceCardTitle"
                           Text="Windows Live Captions"
                           FontSize="12"
                           FontWeight="SemiBold"/>
              </StackPanel>
              <TextBlock x:Name="CaptionSourceCardDescription"
                         Text="자막 언어를 영어로 설정하세요. 시스템 오디오는 무료로 PC 안에서 인식됩니다."
                         Margin="0,9,0,0"
                         Foreground="#7B7B78"
                         FontSize="10"
                         TextWrapping="Wrap"
                         LineHeight="15"/>
              <Button x:Name="OpenCaptionSourceButton"
                      Content="Windows 자막 열기"
                      Click="OpenCaptionSource_Click"
                      Style="{StaticResource QuietButton}"
                      Margin="0,10,0,0"/>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Margin="2,15,0,0">
            <Ellipse x:Name="StatusDot"
                     Width="8" Height="8"
                     Fill="#9C9A96"
                     Margin="0,0,8,0"/>
            <TextBlock x:Name="StatusText"
                       Text="준비됨"
                       Foreground="#626260"
                       FontSize="11"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Background="{StaticResource PaperBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="76"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="92"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1">
        <Grid Margin="24,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="SidebarToggleButton"
                  Grid.Column="0"
                  Content="‹ 설정"
                  Click="ToggleSidebar_Click"
                  Style="{StaticResource QuietButton}"
                  MinWidth="64"
                  Margin="0,0,18,0"
                  VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="새 회의"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="CaptionSourceSubtitle"
                       Text="Windows Live Captions 기반 실시간 번역"
                       Margin="0,4,0,0"
                       Foreground="#7B7B78"
                       FontSize="11"/>
          </StackPanel>
          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <Border Padding="10,6"
                    Background="#111111"
                    CornerRadius="4">
              <TextBlock x:Name="CaptionSourceBadgeText"
                         Text="Windows 자막"
                         Foreground="#FFFFFF"
                         FontSize="10"
                         FontWeight="SemiBold"/>
            </Border>
            <Border Margin="9,0,0,0"
                    Padding="10,6"
                    Background="#F2EFEA"
                    CornerRadius="4">
              <TextBlock x:Name="ProviderBadgeText"
                         Text="무료 Google"
                         Foreground="#626260"
                         FontSize="10"
                         FontWeight="SemiBold"/>
            </Border>
            <Border x:Name="StatusBadge"
                    Margin="9,0,0,0"
                    Padding="10,6"
                    Background="#FAEEE8"
                    CornerRadius="4">
              <TextBlock x:Name="HeaderStatusText"
                         Text="대기 중"
                         Foreground="#C54405"
                         FontSize="10"
                         FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="44"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#E7E3DD"
                BorderThickness="0,0,0,1">
          <Grid Margin="172,0,32,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="1"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="원문"
                         FontSize="11"
                         FontWeight="SemiBold"/>
              <TextBlock Text="English"
                         Margin="8,0,0,0"
                         Foreground="#9C9A96"
                         FontSize="10"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#E7E3DD"/>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Margin="24,0,0,0"
                        VerticalAlignment="Center">
              <TextBlock Text="번역"
                         Foreground="{StaticResource AccentBrush}"
                         FontSize="11"
                         FontWeight="SemiBold"/>
              <TextBlock Text="한국어"
                         Margin="8,0,0,0"
                         Foreground="#9C9A96"
                         FontSize="10"/>
            </StackPanel>
          </Grid>
        </Border>

        <ScrollViewer x:Name="TranscriptScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,0,20">
          <ItemsControl x:Name="TranscriptList"
                        ItemTemplate="{StaticResource SpeakerGroupTemplate}"/>
        </ScrollViewer>

        <StackPanel x:Name="EmptyState"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
          <Border Width="54" Height="54"
                  HorizontalAlignment="Center"
                  Background="#F2EFEA"
                  CornerRadius="27">
            <TextBlock Text="•••"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#FF5600"
                       FontSize="17"
                       FontWeight="Bold"/>
          </Border>
          <TextBlock Text="원문과 번역이 나란히 표시됩니다"
                     Margin="0,16,0,0"
                     HorizontalAlignment="Center"
                     FontSize="17"
                     FontWeight="SemiBold"/>
          <TextBlock x:Name="EmptyStateDescription"
                     Text="같은 화자의 발화는 하나의 흐름으로 이어집니다."
                     Margin="0,7,0,0"
                     Foreground="#7B7B78"
                     FontSize="11"/>
        </StackPanel>
      </Grid>

      <Border Grid.Row="2"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,1,0,0">
        <Grid Margin="30,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border VerticalAlignment="Center"
                  Margin="0,0,20,0"
                  Padding="14,11"
                  Background="#FAF9F6"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Ellipse x:Name="LiveDot"
                       Width="8" Height="8"
                       Fill="#9C9A96"
                       VerticalAlignment="Center"
                       Margin="0,0,11,0"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="실시간 캡션"
                           Foreground="#7B7B78"
                           FontSize="9"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="InterimText"
                           Text="회의를 시작하면 선택한 자막이 여기에 표시됩니다."
                           Margin="0,3,0,0"
                           Foreground="#313130"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <Button x:Name="StopButton"
                    Content="회의 종료"
                    Click="Stop_Click"
                    Style="{StaticResource QuietButton}"
                    MinWidth="104"
                    IsEnabled="False"/>
            <Button x:Name="StartButton"
                    Content="회의 시작"
                    Click="Start_Click"
                    Style="{StaticResource PrimaryButton}"
                    Margin="9,0,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

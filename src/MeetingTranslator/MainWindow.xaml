<Window x:Class="MeetingTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meeting Translator" Width="1040" Height="720" MinWidth="820" MinHeight="560"
        Background="#0F172A" Foreground="#E2E8F0">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel>
      <StackPanel>
        <TextBlock Text="Meeting Translator" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="시스템 소리와 내 마이크를 실시간으로 전사·번역·저장합니다."
                   Foreground="#94A3B8" Margin="0,6,0,0"/>
      </StackPanel>
      <Border DockPanel.Dock="Right" Background="#1E293B" CornerRadius="16" Padding="14,8">
        <TextBlock x:Name="StatusText" Text="준비됨" Foreground="#93C5FD"/>
      </Border>
    </DockPanel>

    <Border Grid.Row="1" Margin="0,20,0,16" Padding="18" Background="#1E293B" CornerRadius="14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="Google Cloud 프로젝트 ID" Foreground="#94A3B8"/>
          <TextBox x:Name="ProjectIdBox" Margin="0,6,0,0" Padding="10" Background="#334155"
                   Foreground="White" BorderThickness="0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,12,0">
          <TextBlock Text="서비스 계정 JSON 파일" Foreground="#94A3B8"/>
          <DockPanel Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" x:Name="BrowseButton" Content="찾기" Click="BrowseCredentials_Click"
                    Padding="14,8" Margin="8,0,0,0"/>
            <TextBox x:Name="CredentialsBox" Padding="10" Background="#334155" Foreground="White"
                     BorderThickness="0"/>
          </DockPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
          <CheckBox x:Name="SystemAudioCheck" Content="시스템 소리" IsChecked="True" Margin="0,0,0,6"/>
          <CheckBox x:Name="MicrophoneCheck" Content="내 마이크" IsChecked="True"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="#111827" CornerRadius="14" Padding="16">
      <DataGrid x:Name="TranscriptGrid" AutoGenerateColumns="False" IsReadOnly="True"
                Background="#111827" Foreground="#E2E8F0" BorderThickness="0"
                RowBackground="#111827" AlternatingRowBackground="#172033"
                HeadersVisibility="Column" GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
          <DataGridTextColumn Header="시간" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="90"/>
          <DataGridTextColumn Header="화자" Binding="{Binding SourceLabel}" Width="90"/>
          <DataGridTextColumn Header="원문" Binding="{Binding OriginalText}" Width="*"/>
          <DataGridTextColumn Header="한국어" Binding="{Binding TranslatedText}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <DockPanel Grid.Row="3" Margin="0,16,0,0">
      <TextBlock x:Name="InterimText" VerticalAlignment="Center" Foreground="#94A3B8"
                 TextTrimming="CharacterEllipsis"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="StartButton" Content="회의 시작" Click="Start_Click" Padding="22,11"
                Background="#2563EB" Foreground="White" BorderThickness="0"/>
        <Button x:Name="StopButton" Content="회의 종료" Click="Stop_Click" Padding="22,11"
                Margin="10,0,0,0" IsEnabled="False"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
